# Copy to .env and fill in. Read by docker-compose.yml, and by the backend when run locally.

POSTGRES_USER=study
POSTGRES_PASSWORD=study
POSTGRES_DB=study_assistant
# For running the backend outside Docker; docker-compose.yml points the container at `db` instead.
DATABASE_URL=postgresql+asyncpg://study:study@localhost:5432/study_assistant

# Origin the browser uses. Google redirect URI to register: ${APP_URL}/api/auth/callback
APP_URL=http://localhost:3000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
COOKIE_SECURE=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Embeddings (fixed to OpenAI)
OPENAI_API_KEY=

# Chat model, called through LiteLLM. To switch provider change CHAT_MODEL, plus CHAT_API_BASE for
# a self-hosted model's URL.
CHAT_MODEL=anthropic/claude-sonnet-5
ANTHROPIC_API_KEY=
CHAT_API_BASE=
# Only for a non-Anthropic CHAT_MODEL: that provider's key. When set (non-empty) it's used instead of
# ANTHROPIC_API_KEY. Don't leave an empty CHAT_API_KEY= line; it would hide ANTHROPIC_API_KEY.
# CHAT_API_KEY=
